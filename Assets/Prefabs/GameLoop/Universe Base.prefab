  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameJamPlus.Gameplay.StageEndManager
  gameManager: {fileID: 9019079769948831600}
  hud: {fileID: 9101879148219320924}
  dialogues: {fileID: 9392838306}
  defaultTransitionDuration: 1.5
  starvation:
    dialogueCase: 4
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has demonstrated the importance of a healthy, balanced diet.
    - The subject has investigated the effects of prolonged fasting.
  drowning:
    dialogueCase: 5
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has explored its breath-holding limits.
    - The subject has demonstrated that breathing matters even underwater.
  poisoning:
    dialogueCase: 9
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has chosen to rest after its meal.
    - The feeding stage ended with a rest break.
  crushing:
    dialogueCase: 0
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has completed the pressure stage.
  electricShock:
    dialogueCase: 13
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has demonstrated outstanding conductivity.
  mouseTrap:
    dialogueCase: 14
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has reported a misplaced object in room seven.
    - Looks like someone had one snack too many. Better get some rest!
  fall:
    dialogueCase: 11
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has investigated how gravity works.
    - The subject has completed the descent with remarkable determination.
  goal:
    dialogueCase: 12
    subjectDied: 0
    useExitImage: 1
    completionObservations: 128
    flashDurationOverride: -1
    resultMessages:
    - The subject has escaped the maze and completed the trial.
    - The subject has successfully reached the exit and has been recovered alive.
  cheeseGoal:
    dialogueCase: 7
    subjectDied: 0
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has enjoyed ten portions of cheese and completed the trial in good
      health.
  photoGoal:
    dialogueCase: 10
    subjectDied: 0
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has become too curious after examining three photographs.
    - The subject has exceeded the recommended level of curiosity.
  piranha:
    dialogueCase: 3
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject is attracted to fish.
--- !u!114 &9392838306
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4765706860712224773}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48b86620b0fc4ec2b56357675feb1ac5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameJamPlus.UI.DialogueManager
  hud: {fileID: 9101879148219320924}
  defaultEnding:
    avatar: {fileID: 0}
    messages:
    - Excellent. We can consider this stage complete.
    duration: 7
  welcome:
    avatar: {fileID: 21300000, guid: d43949e9434a9b34ebb39592a7ac0cb6, type: 3}
    messages:
    - Welcome to Universe-{universe}. Relax and enjoy your stay.
    duration: 7
  starvation:
    avatar: {fileID: 0}
    messages:
    - A healthy, balanced diet is the foundation of a long life.
    - Meals are very important. Let us remember that for the next stage.
    duration: 7
  drowning:
    avatar: {fileID: 0}
    messages:
    - A break to catch your breath is always a good idea.
    - Let us remind the subject to breathe between exercises.
    duration: 7
  lowOxygen:
    avatar: {fileID: 0}
    messages:
    - Excellent concentration! Let us remember to breathe, though.
    - A quick trip to the surface helps keep the mind clear.
    duration: 7
  cheeseCollected:
    avatar: {fileID: 21300000, guid: d43949e9434a9b34ebb39592a7ac0cb6, type: 3}
    messages:
    - Excellent choice. Some cheese to keep exploring.
    - Cheese collected. Let us see what you find in the next room.
    - A small reward for your curiosity.
    - I see you have made yourself comfortable. Keep it up!
    duration: 7
  poisoned:
    avatar: {fileID: 21300000, guid: d43949e9434a9b34ebb39592a7ac0cb6, type: 3}
    messages:
    - Good, very good. It is time to rest.
    - Yes, I think a nap is just what you need.
    - Oh, going to sleep already? What a shame...
    duration: 7
  cheeseGoal:
    avatar: {fileID: 0}
    messages:
    - Excellent appetite! That is enough cheese for this trial. Time for a well-earned
      rest.
    - Ten portions already! What a healthy appetite. We can conclude this trial here.
    duration: 7
  photoGoal:
    avatar: {fileID: 0}
    messages:
    - Three photographs already? Such curiosity! We had better take a break now.
    - You have seen quite enough for today. Let us give that curious mind a rest.
    - What an inquisitive little mouse. Further observation will not be necessary.
    duration: 7
  piranha:
    avatar: {fileID: 0}
    messages:
    - How sociable! You have already made friends with the fish. Let us take a break
      now.
    - I see you have found some new aquatic friends. I would say you have socialized
      enough for today!
    duration: 7
  fallDeath:
    avatar: {fileID: 0}
    messages:
    - Interesting. The subject has decided to explore gravity personally.
    - A very convincing descent. I would say we have earned a break.
    - Excellent, the descent stage is complete too. Let us rest for a moment.
    duration: 7
  goal:
    avatar: {fileID: 21300000, guid: d43949e9434a9b34ebb39592a7ac0cb6, type: 3}
    messages:
    - You found the way out! Excellent navigation. Your trial is complete; enjoy
      a well-deserved rest.
    - Splendid! Another successful journey through the maze. We can conclude this
      trial here.
    duration: 7
  electricShock:
    avatar: {fileID: 0}
    messages:
    - Ah, a passion for science and electricity. I know that irresistible temptation.
    duration: 7
  mouseTrap:
    avatar: {fileID: 0}
    messages:
    - That should not have been there! Clean room seven.
    duration: 7
