  gameManager: {fileID: 955552920795627385}
  hud: {fileID: 1024751199806863312}
  dialogues: {fileID: 8100000009106314923}
  defaultTransitionDuration: 1.5
  starvation:
    dialogueCase: 4
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has demonstrated the importance of a healthy, balanced diet.
    - The subject has investigated the effects of prolonged fasting.
  drowning:
    dialogueCase: 5
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has explored its breath-holding limits.
    - The subject has demonstrated that breathing matters even underwater.
  poisoning:
    dialogueCase: 9
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has chosen to rest after its meal.
    - The feeding stage ended with a rest break.
  crushing:
    dialogueCase: 0
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has completed the pressure stage.
  electricShock:
    dialogueCase: 13
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has demonstrated outstanding conductivity.
  mouseTrap:
    dialogueCase: 14
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has reported a misplaced object in room seven.
    - Looks like someone had one snack too many. Better get some rest!
  fall:
    dialogueCase: 11
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has investigated how gravity works.
    - The subject has completed the descent with remarkable determination.
  goal:
    dialogueCase: 12
    subjectDied: 0
    useExitImage: 1
    completionObservations: 128
    flashDurationOverride: -1
    resultMessages:
    - The subject has escaped the maze and completed the trial.
    - The subject has successfully reached the exit and has been recovered alive.
  cheeseGoal:
    dialogueCase: 7
    subjectDied: 0
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has enjoyed ten portions of cheese and completed the trial in good
      health.
  photoGoal:
    dialogueCase: 10
    subjectDied: 0
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject has become too curious after examining three photographs.
    - The subject has exceeded the recommended level of curiosity.
  piranha:
    dialogueCase: 3
    subjectDied: 1
    useExitImage: 0
    completionObservations: 0
    flashDurationOverride: -1
    resultMessages:
    - The subject is attracted to fish.
