@import url("InputPrompts.uss");
.pause-card.controls-open {
    width: 420px;
    height: 344px;
    min-height: 0;
    max-width: 96%;
    max-height: 96%;
    padding: 8px 14px;
    background-color: rgb(20, 43, 58);
}
.controls-open .pause-kicker, .controls-open .pause-title,
.controls-open .pause-status, .controls-open .pause-hint { display: none; }
.body-controls { flex-grow: 1; }
.body-title { height: 16px; margin: 0; font-size: 10px; color: rgb(240, 229, 202); -unity-text-align: middle-center; }
.body-diagram { width: 100%; height: 188px; flex-shrink: 0; }
.body-image { -unity-background-scale-mode: scale-to-fit; position: absolute; left: 50%; margin-left: -94px; top: 20px; width: 188px; height: 188px; }
.body-scanner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.body-callout {
    position: absolute;
    min-width: 28px;
    max-width: 74px;
    height: 28px;
    margin: 0;
    padding: 3px 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(240, 229, 202);
    background-color: rgb(10, 26, 37);
    border-width: 1px;
    border-color: rgb(240, 229, 202);
    border-radius: 14px;
}
.body-callout-0 { left: 32%; top: 10px; }
.body-callout-1 { left: 25%; top: 104px; }
.body-callout-2 { left: 36%; bottom: 1px; }
.body-callout-3 { right: 25%; top: 108px; }
.body-details { width: 100%; height: 36px; justify-content: center; }
.body-description { font-size: 8px; white-space: normal; margin: 0; -unity-text-align: middle-center; }
.body-feedback { font-size: 8px; white-space: normal; color: rgb(240, 229, 202); margin: 2px 0 0 0; -unity-text-align: middle-center; }
.body-navigation {
    flex-direction: row;
    align-items: stretch;
    height: 36px;
    flex-shrink: 0;
    background-color: rgb(10, 26, 37);
    border-width: 1px;
    border-color: rgb(64, 101, 117);
    border-radius: 5px;
}
.body-navigation .pause-button { height: 34px; padding: 2px 4px; -unity-text-align: middle-center; font-size: 8px; }
.body-tab { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; border-radius: 4px; }
.body-tab-dot { width: 5px; height: 5px; margin-bottom: 3px; border-width: 1px; border-color: rgb(135, 160, 171); border-radius: 3px; }
.body-tab-active { border-color: transparent; background-color: transparent; }
.body-tab-active .body-tab-dot { background-color: rgb(240, 229, 202); border-color: rgb(240, 229, 202); }
.controls-open .pause-button:hover { background-color: transparent; border-color: transparent; }
.controls-open .pause-button.pause-selected {
    background-color: rgba(240, 229, 202, 0.1);
    border-color: rgb(240, 229, 202);
}
.body-arrow { width: 25px; flex-shrink: 0; }
.body-tools { height: 22px; flex-direction: row; justify-content: center; }
.body-tools .pause-button { font-size: 8px; -unity-text-align: middle-center; }
.body-help { font-size: 7px; white-space: normal; margin: 2px 0; -unity-text-align: middle-center; }
.controls-open #pause-controls-back { height: 16px; font-size: 8px; }

.body-connectors { --body-connector-color: rgb(240, 229, 202); --body-connector-width: 1; --body-anchor-color: rgb(64, 224, 240); position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.body-tab > Label { font-size: 8px; margin: 0; white-space: normal; -unity-text-align: middle-center; }

.body-binding-modal {
    display: none;
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(4, 12, 20, 0.96);
    align-items: center; justify-content: center;
}
.body-binding-card {
    width: 90%; padding: 20px 12px;
    background-color: rgb(20, 43, 58);
    border-width: 1px; border-color: rgb(240, 229, 202); border-radius: 4px;
}
.body-binding-title { font-size: 12px; white-space: normal; color: rgb(240, 229, 202); margin-bottom: 12px; -unity-text-align: middle-center; }
.body-binding-choices { flex-direction: row; justify-content: center; margin-top: 14px; }
.body-binding-choices .pause-button { min-width: 65px; -unity-text-align: middle-center; }

.body-controls-shared { flex-grow: 1; color: rgb(240, 229, 202); -unity-font: url("../../Art/UI/Gameplay/Fonts/m6x11.ttf"); }
.controls-stage { background-color: rgb(240, 229, 202); align-items: center; justify-content: center; }
.controls-scene-footer { flex-direction: row; justify-content: space-between; align-items: center; height: 22px; flex-shrink: 0; }
.controls-scene-footer .pause-button { height: 16px; font-size: 8px; }
.controls-scene-footer .body-help { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin: 0 6px; -unity-text-align: middle-center; }

.body-anchor { position: absolute; width: 0; height: 0; }

.controls-open .pause-button { color: rgb(240, 229, 202); }

.body-page, .body-binding-card { color: rgb(240, 229, 202); -unity-font: url("../../Art/UI/Gameplay/Fonts/m6x11.ttf"); }
.body-page-slot { flex-shrink: 0; }
.body-camera-callout {
    right: 12px;
    top: 2px;
    width: 150px;
    max-width: 44%;
    height: auto;
    min-height: 40px;
    border-radius: 3px;
    font-size: 7px;
    -unity-text-align: middle-left;
}

.body-controls-shared, .body-controls-shared *,
.body-page, .body-page *, .body-binding-card, .body-binding-card * {
    -unity-font: url("../../Art/UI/Gameplay/Fonts/m6x11.ttf");
}
