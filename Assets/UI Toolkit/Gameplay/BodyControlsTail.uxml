            <ui:VisualElement name="body-image" class="body-image" picking-mode="Ignore" style="background-image: url('project://database/Assets/Art/UI/Gameplay/Button%20Scheme-Sheet.png?fileID=-4916312091047471733&amp;guid=97bbe0555ce045b46ad67245c2b9f1d2&amp;type=3#Button%20Scheme-Sheet_4');">
