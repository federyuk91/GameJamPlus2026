<ui:UXML xmlns:game="GameJamPlus.UI" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="Overview" src="BodyControlsOverview.uxml" />
    <Style src="GameplayHud.uss" />
    <Style src="BodyControls.uss" />
    <Style src="../UserInterfaceSprites.uss" />
    <ui:VisualElement class="gameplay-hud controls-stage">
        <ui:VisualElement class="pause-card controls-open">
            <ui:Label text="CONTROLS" class="body-title" />
            <ui:VisualElement name="controls-overview" class="body-controls">
                <ui:Instance template="Overview" />
            </ui:VisualElement>
            <ui:VisualElement class="controls-scene-footer">
                <ui:VisualElement name="controls-navigation-help" class="body-help input-prompt-row">
                    <game:InputPromptElement binding="confirm" preview-path="&lt;Keyboard&gt;/space" preview-label="Space" />
                    <ui:Label text="Continue" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button name="controls-continue" text="Continue" class="pause-button pause-selected sprite-button sprite-continue" />
            </ui:VisualElement>
            <ui:Label name="controls-status" class="body-feedback" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
