<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=b889d0467f7f4d73a171bcd9aad6284b&amp;type=3#MainMenu" />
    <ui:VisualElement class="display-frame">
        <ui:VisualElement name="menu-root" class="menu-root">
            <ui:VisualElement picking-mode="Ignore" class="background" />
            <ui:VisualElement class="content">
                <ui:VisualElement class="menu-column">
                    <ui:Label text="WELCOME PROGRAM" class="program-heading" />
                    <ui:VisualElement picking-mode="Ignore" tooltip="UNIVERSE-10" class="title-logo" />
                    <ui:Label text="A home for every mouse" class="subtitle" />
                    <ui:VisualElement name="main-panel" class="main-panel">
                        <ui:Button name="new-game" tabindex="1" class="menu-button">
                            <ui:Label text="▶" picking-mode="Ignore" class="menu-pointer" />
                            <ui:Label text="New Game" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="options" tabindex="2" class="menu-button">
                            <ui:Label text="▶" picking-mode="Ignore" class="menu-pointer" />
                            <ui:Label text="Options" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="credits" tabindex="3" class="menu-button">
                            <ui:Label text="▶" picking-mode="Ignore" class="menu-pointer" />
                            <ui:Label text="Credits" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="quit" tabindex="4" class="menu-button">
                            <ui:Label text="▶" picking-mode="Ignore" class="menu-pointer" />
                            <ui:Label text="Quit" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="status" class="status" />
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Position" class="art-column">
                    <ui:VisualElement class="room-card">
                        <ui:VisualElement class="room-header">
                            <ui:Label text="WELCOME ROOM" class="eyebrow" name="channel-title" />
                            <ui:VisualElement class="online-status">
                                <ui:VisualElement class="ready-light" />
                                <ui:Label text="ONLINE" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="channel-viewport" class="channel-viewport">
                            <ui:VisualElement name="channel-aperture" class="channel-aperture">
                                <ui:VisualElement name="channel-content" class="channel-content">
                                    <ui:VisualElement name="welcome-panel" class="welcome-panel">
                                        <ui:VisualElement class="key-art" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="options-panel" class="context-card hidden">
                                        <ui:Label text="AUDIO" class="section-heading" />
                                        <ui:Slider name="volume" label="Master" low-value="0" high-value="1" value="1" class="audio-slider" />
                                        <ui:Slider name="music-volume" label="Music" low-value="0" high-value="1" value="1" class="audio-slider" />
                                        <ui:Slider name="effects-volume" label="Effects" low-value="0" high-value="1" value="1" class="audio-slider" />
                                        <ui:Label text="DISPLAY" class="section-heading" />
                                        <ui:Toggle name="fullscreen" label="Fullscreen" value="true" />
                                        <ui:Button name="options-back" text="Back" class="dialog-button" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="credits-panel" class="context-card hidden">
                                        <ui:Label text="THE PEOPLE BEHIND THE PROGRAM" class="section-heading" />
                                        <ui:VisualElement class="credit-row">
                                            <ui:VisualElement class="credit-details">
                                                <ui:Label text="Designer &amp; Programmer" class="credit-role" />
                                                <ui:Label name="credit-designer-programmer" text="Federico Bachis" class="credit-name" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="credit-row">
                                            <ui:VisualElement class="credit-details">
                                                <ui:Label text="Artist" class="credit-role" />
                                                <ui:Label name="credit-artist" text="Roberta Piredda" class="credit-name" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="credit-row">
                                            <ui:VisualElement class="credit-details">
                                                <ui:Label text="Pixel Artist" class="credit-role" />
                                                <ui:Label name="credit-pixel-artist" text="Andrea Serra" class="credit-name" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="credit-row">
                                            <ui:VisualElement class="credit-details">
                                                <ui:Label text="Sound &amp; Music" class="credit-role" />
                                                <ui:Label name="credit-sound-music" text="Giuliano Cau" class="credit-name" />
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                        <ui:Label text="Special Thanks" class="special-thanks-title" />
                                        <ui:VisualElement class="special-thanks-logos">
                                            <ui:VisualElement name="thanks-gamejamplus" tooltip="GameJamPlus" picking-mode="Ignore" class="thanks-logo thanks-gamejamplus" />
                                            <ui:VisualElement name="thanks-igda-italy" tooltip="IGDA Italy" picking-mode="Ignore" class="thanks-logo thanks-igda-italy" />
                                            <ui:VisualElement name="thanks-sgs" tooltip="SGS" picking-mode="Ignore" class="thanks-logo thanks-sgs" />
                                        </ui:VisualElement>
                                        <ui:Label text="m5x7 &amp; m6x11 fonts by Daniel Linssen" tooltip="https://managore.itch.io/m5x7 · https://managore.itch.io/m6x11" class="font-credit" />
                                    </ui:VisualElement>
                                    <ui:VisualElement name="quit-panel" class="context-card hidden">
                                        <ui:Label text="Leave the laboratory?" class="dialog-title" />
                                        <ui:Button name="quit-back" text="Cancel" class="dialog-button" />
                                        <ui:Button name="quit-confirm" text="Quit" class="dialog-button" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="room-status">
                            <ui:VisualElement class="ready-light" />
                            <ui:Label text="ENVIRONMENT READY" class="art-caption" style="-unity-text-align: middle-center;" name="channel-status" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label text="Play. Eat. Learn. Relax." class="welcome-note" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="footer">
                <ui:Label name="menu-navigation-hint" text="WASD / Arrows  Navigate" />
                <ui:Label name="menu-action-hint" text="Space  Confirm     Esc  Back" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
