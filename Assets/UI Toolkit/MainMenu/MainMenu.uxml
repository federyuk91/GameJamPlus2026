<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=b889d0467f7f4d73a171bcd9aad6284b&amp;type=3"/>
    <ui:VisualElement class="display-frame">
        <ui:VisualElement name="menu-root" class="menu-root">
            <ui:VisualElement picking-mode="Ignore" class="background"/>
            <ui:VisualElement picking-mode="Ignore" class="shade"/>
            <ui:VisualElement class="content">
                <ui:VisualElement class="menu-column">
                    <ui:VisualElement class="brand-row">
                        <ui:VisualElement picking-mode="Ignore" class="logo"/>
                        <ui:Label text="LABORATORIO: AREA PUZZLE" class="brand-label"/>
                    </ui:VisualElement>
                    <ui:Label text="UNIVERSE-10&#10;Please press continue" class="title"/>
                    <ui:VisualElement name="main-panel" class="main-panel">
                        <ui:Button name="new-game" tabindex="1" class="menu-button">
                            <ui:VisualElement picking-mode="Ignore" class="icon new-game-icon"/>
                            <ui:Label text="Nuovo Gioco" picking-mode="Ignore"/>
                        </ui:Button>
                        <ui:Button name="options" tabindex="2" class="menu-button">
                            <ui:VisualElement picking-mode="Ignore" class="icon options-icon"/>
                            <ui:Label text="Opzioni" picking-mode="Ignore"/>
                        </ui:Button>
                        <ui:Button name="credits" tabindex="3" class="menu-button">
                            <ui:VisualElement picking-mode="Ignore" class="icon credits-icon"/>
                            <ui:Label text="Crediti" picking-mode="Ignore"/>
                        </ui:Button>
                        <ui:Button name="quit" tabindex="4" class="menu-button">
                            <ui:VisualElement picking-mode="Ignore" class="icon quit-icon"/>
                            <ui:Label text="Esci" picking-mode="Ignore"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="status" class="status"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="art-column">
                    <ui:VisualElement class="room-card">
                        <ui:VisualElement class="room-header">
                            <ui:Label text="SALA DI BENVENUTO" class="eyebrow"/>
                            <ui:VisualElement class="ready-light"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="key-art" style="-unity-background-scale-mode: scale-to-fit; background-position-y: center; background-position-x: center; background-size: contain; -unity-slice-scale: 1px; -unity-slice-type: sliced;"/>
                        <ui:VisualElement class="room-controls">
                            <ui:VisualElement class="room-button"/>
                            <ui:VisualElement class="room-button room-button-secondary"/>
                            <ui:VisualElement class="room-button room-button-tertiary"/>
                        </ui:VisualElement>
                        <ui:Label text="L&apos;Ambiente è pronto!" class="art-caption"/>
                    </ui:VisualElement>
                    <ui:Label text="Gioca, Mangia, Impara, Rilassati.&#10;In un meraviglioso universo per Topi." class="welcome-note"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="footer">
                <ui:Label text="Stick / D-pad · A / Croce · B / Cerchio"/>
                <ui:Label text="Frecce / Tab · Invio · Esc"/>
            </ui:VisualElement>
            <ui:VisualElement name="modal" class="modal hidden">
                <ui:VisualElement class="dialog">
                    <ui:VisualElement name="options-panel" class="hidden">
                        <ui:Label text="Opzioni" class="dialog-title"/>
                        <ui:Slider name="volume" label="Master" low-value="0" high-value="1" value="1" class="audio-slider"/>
                        <ui:Slider name="music-volume" label="Musica" low-value="0" high-value="1" value="1" class="audio-slider"/>
                        <ui:Slider name="effects-volume" label="Effetti" low-value="0" high-value="1" value="1" class="audio-slider"/>
                        <ui:Toggle name="fullscreen" label="Schermo intero"/>
                        <ui:Button name="options-back" text="Indietro" class="dialog-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="credits-panel" class="hidden">
                        <ui:Label text="Crediti" class="dialog-title"/>
                        <ui:Label text="PLEASE PRESS CONTINUE&#10;&#10;Designer&amp;Programmer - Federico Bachis&#10;Artist - Roberta Piroddi&#10;Pixel Artist - Andrea Serra&#10;Sound&amp;Music - Giuliano Cau&#10;&#10;Grazie per la visita." class="credits-text"/>
                        <ui:Button name="credits-back" text="Indietro" class="dialog-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="quit-panel" class="hidden">
                        <ui:Label text="Vuoi lasciare il laboratorio?" class="dialog-title"/>
                        <ui:Button name="quit-back" text="Annulla" class="dialog-button"/>
                        <ui:Button name="quit-confirm" text="Esci" class="dialog-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
